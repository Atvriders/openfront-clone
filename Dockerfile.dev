# Self-contained local deployment of the OpenFront.io clone.
#
# This is an additive alternative to the upstream Dockerfile (which targets a
# multi-domain production cluster behind a real API + Cloudflare Turnstile).
#
# Differences from upstream:
#   - The client is built in development mode (`vite build --mode development`),
#     so GAME_ENV is "dev" in the bundle: no Turnstile CAPTCHA, anonymous auth
#     via persistentID, and assets are served at root paths from ./static.
#   - The server runs with GAME_ENV=dev (2 worker processes, no external API).
#
# Everything else (nginx routes, supervisor, ports 3000-3002) matches upstream.

FROM node:24-slim AS base
WORKDIR /usr/src/app

# Build stage - install ALL dependencies and build
FROM base AS build
ENV HUSKY=0
# Copy package files first for better caching
COPY package*.json ./
RUN npm ci

# Copy only what's needed for build
COPY tsconfig.json ./
COPY vite.config.ts ./
COPY eslint.config.js ./
COPY index.html ./
COPY resources ./resources
COPY proprietary ./proprietary
COPY src ./src

ARG GIT_COMMIT=unknown
ENV GIT_COMMIT="$GIT_COMMIT"
RUN npm run build-dev

# Final image
FROM base

# Install system dependencies
RUN apt-get update && apt-get install -y \
    nginx \
    curl \
    supervisor \
    apache2-utils \
    && rm -rf /var/lib/apt/lists/*

# Update worker_connections in nginx.conf
RUN sed -i 's/worker_connections [0-9]*/worker_connections 8192/' /etc/nginx/nginx.conf

# Setup supervisor configuration
RUN mkdir -p /var/log/supervisor
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Copy Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN rm -f /etc/nginx/sites-enabled/default

# Copy node_modules from build stage (includes tsx + dev deps needed by the server)
COPY --from=build /usr/src/app/node_modules ./node_modules
COPY package*.json ./

# Copy built artifacts from build stage
COPY --from=build /usr/src/app/static ./static

# The dev-mode build already placed the public assets (including maps) in ./static
COPY resources ./resources
RUN rm -rf ./resources/maps
COPY tsconfig.json ./
COPY src ./src

ARG GIT_COMMIT=unknown
RUN echo "$GIT_COMMIT" > static/commit.txt

ENV GAME_ENV=dev
ENV GIT_COMMIT="$GIT_COMMIT"

CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
